# Copy to .env and fill in. NEVER commit .env.

# Shared secret with the main backend (it calls us server-to-server)
API_KEY=change-me-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
# Company sites allowed to open the login popup (* = any subdomain)
FRONTEND_ORIGIN_PATTERNS=http://*.localhost:3000,https://*.axolo.ai

# Axolo backend URL we notify on completed / updated / undone / closed (empty = off)
AXOLO_WEBHOOK_URL=http://localhost:8080/hooks/axolo-agent
WEBHOOK_MAX_TRIES=8

# Database / Redis (docker-compose overrides these for the containers)
DATABASE_URL=postgresql+asyncpg://axolo:axolo@localhost:55432/axolo
REDIS_URL=redis://localhost:56379/0
DB_USE_NULL_POOL=false
DB_PGBOUNCER=false

# Fernet key for encrypting client tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_CONCURRENT=20

# GitHub OAuth app - callback URL must be: {PUBLIC_BASE_URL}/api/v1/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Limits
RATE_LIMIT_PER_MINUTE=120
WORKER_MAX_JOBS=4
JOB_TIMEOUT_SECONDS=1200
BUILD_TIMEOUT_SECONDS=600

# Session closes by itself this long after the agent publishes (Undo works until then) - 10 minutes
AUTO_CLOSE_SECONDS=600

# After a push, watch the live website and say "Done ✓ … live" + View my site (Vercel / Netlify / GitHub only).
# Off: every platform gets "I've added the Team Portal button … It's deploying now" at once.
DEPLOY_WATCH_ENABLED=false
